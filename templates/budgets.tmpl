{{define "budgets.tmpl"}}
{{template "base.tmpl" .}}
<div class="container">
    <h1>Budgets</h1>
    <a href="/budgets/new" class="btn">Add New Budget</a>
    <table class="table">
        <thead>
            <tr>
                <th>Category</th>
                <th>Amount</th>
                <th>Month</th>
                <th>Year</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{range .budgets}}
            <tr>
                <td>{{if .Category}}{{.Category.Name}}{{else}}Overall{{end}}</td>
                <td>{{.Amount}}</td>
                <td>{{.Month}}</td>
                <td>{{.Year}}</td>
                <td>
                    <a href="/budgets/{{.ID}}/edit">Edit</a> |
                    <form action="/budgets/{{.ID}}/delete" method="POST" style="display:inline;">
                        <button type="submit" onclick="return confirm('Are you sure?')">Delete</button>
                    </form>
                </td>
            </tr>
            {{end}}
        </tbody>
    </table>
</div>
{{end}}