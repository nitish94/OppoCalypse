{{define "graphs.tmpl"}}
{{template "base.tmpl" .}}
<div class="container">
    <h1>Financial Graphs</h1>
    <div style="display: flex; flex-wrap: wrap;">
        <div style="width: 50%; min-width: 400px;">
            <h2>Income and Expense Over Time (Bar Chart)</h2>
            <canvas id="incomeExpenseChart"></canvas>
        </div>
        <div style="width: 50%; min-width: 400px;">
            <h2>Income and Expense Over Time (Line Chart)</h2>
            <canvas id="incomeExpenseLineChart"></canvas>
        </div>
        <div style="width: 50%; min-width: 400px;">
            <h2>Income by Category (Pie Chart)</h2>
            <canvas id="incomePieChart"></canvas>
        </div>
        <div style="width: 50%; min-width: 400px;">
            <h2>Expense by Category (Pie Chart)</h2>
            <canvas id="expensePieChart"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Bar Chart
    const ctxBar = document.getElementById('incomeExpenseChart').getContext('2d');
    const incomeData = JSON.parse('{{.incomeDataJSON}}');
    const expenseData = JSON.parse('{{.expenseDataJSON}}');
    const incomeLabels = incomeData.map(d => d.label);
    const expenseLabels = expenseData.map(d => d.label);
    const allLabels = [...new Set([...incomeLabels, ...expenseLabels])].sort();
    const incomeValues = allLabels.map(label => {
        const item = incomeData.find(d => d.label === label);
        return item ? item.value : 0;
    });
    const expenseValues = allLabels.map(label => {
        const item = expenseData.find(d => d.label === label);
        return item ? item.value : 0;
    });
    new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: allLabels,
            datasets: [{
                label: 'Income',
                data: incomeValues,
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 1
            }, {
                label: 'Expense',
                data: expenseValues,
                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                borderColor: 'rgba(255, 99, 132, 1)',
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });

    // Line Chart
    const ctxLine = document.getElementById('incomeExpenseLineChart').getContext('2d');
    new Chart(ctxLine, {
        type: 'line',
        data: {
            labels: allLabels,
            datasets: [{
                label: 'Income',
                data: incomeValues,
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                tension: 0.1
            }, {
                label: 'Expense',
                data: expenseValues,
                borderColor: 'rgba(255, 99, 132, 1)',
                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                tension: 0.1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });

    // Income Pie Chart
    const ctxIncomePie = document.getElementById('incomePieChart').getContext('2d');
    const incomeCatData = JSON.parse('{{.incomeCatDataJSON}}');
    new Chart(ctxIncomePie, {
        type: 'pie',
        data: {
            labels: incomeCatData.map(d => d.label),
            datasets: [{
                data: incomeCatData.map(d => d.value),
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(255, 159, 64, 0.2)'
                ],
                borderColor: [
                    'rgba(255, 99, 132, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)'
                ],
                borderWidth: 1
            }]
        }
    });

    // Expense Pie Chart
    const ctxExpensePie = document.getElementById('expensePieChart').getContext('2d');
    const expenseCatData = JSON.parse('{{.expenseCatDataJSON}}');
    new Chart(ctxExpensePie, {
        type: 'pie',
        data: {
            labels: expenseCatData.map(d => d.label),
            datasets: [{
                data: expenseCatData.map(d => d.value),
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(255, 159, 64, 0.2)'
                ],
                borderColor: [
                    'rgba(255, 99, 132, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)'
                ],
                borderWidth: 1
            }]
        }
    });
});
</script>
{{end}}